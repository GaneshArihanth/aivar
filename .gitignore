# --- Terraform -------------------------------------------------------------
# State contains every secret in plaintext; tfvars contains them before that.
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
terraform/*.tfvars
!terraform/*.tfvars.example
terraform/.terraform.lock.hcl
crash.log
