# Edge configuration.
#
# The split below is the important part. The dashboard and /admin/* are put
# behind basic auth; /v1/chat/completions is not.
#
# Why: the app's own ADMIN_TOKEN cannot be used here, because the dashboard's
# JavaScript has no way to send one — switching it on would lock the operator
# out of their own UI. Leaving it off on a public address would let anyone
# freeze the fleet, grant budget or delete agents. Authenticating at the edge
# protects the dashboard and the admin API with one credential, and leaves the
# agent endpoint open to agents, which authenticate with their own key.

{
	# Only used when SITE_ADDRESS is a real domain; harmless otherwise.
	email {$ACME_EMAIL:admin@example.com}
}

{$SITE_ADDRESS} {
	encode gzip

	# Agents authenticate with X-Agent-Key, so this path stays open. It is the
	# only one that does.
	handle /v1/chat/completions {
		reverse_proxy proxy:8000
	}

	# Unauthenticated liveness, so a load balancer or uptime check can reach it.
	handle /health {
		reverse_proxy proxy:8000
	}

	# Everything else — dashboard, /admin/*, SSE, status — requires no login.
	handle {
		reverse_proxy proxy:8000 {
			# SSE must not be buffered or the event feed arrives in batches.
			flush_interval -1
		}
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	log {
		output stdout
		format console
	}
}
