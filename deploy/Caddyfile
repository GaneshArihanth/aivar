# Edge configuration.
#
# There is no authentication here, by decision: the dashboard and the whole
# admin API are open to anyone who can reach this address.
#
# What that means in practice, so it is never a surprise:
#   · anyone can read every team, agent, budget and event
#   · anyone can create, edit, pause or delete agents, rotate keys, grant
#     budget boosts, and freeze or resume all dispatch
#   · agent API keys are never exposed — only their `sk-agent-xxxxxx` prefix,
#     and the raw key is returned exactly once at creation
#
# Agent traffic on /v1/chat/completions is still authenticated, by the agent's
# own X-Agent-Key. That is unaffected by anything here.
#
# To close it later, put this back inside a `handle` that excludes
# /v1/chat/completions and /health:
#
#     basic_auth {
#         {$DASHBOARD_USER} {$DASHBOARD_PASSWORD_HASH}
#     }

{
	# Only used when SITE_ADDRESS is a real domain; harmless otherwise.
	email {$ACME_EMAIL:admin@example.com}
}

{$SITE_ADDRESS} {
	encode gzip

	reverse_proxy proxy:8000 {
		# SSE must not be buffered or the event feed arrives in batches
		# instead of live.
		flush_interval -1
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	log {
		output stdout
		format console
	}
}
