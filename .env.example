# Copy to .env and adjust. Defaults target the Homebrew services set up by
# `make infra-up`.

# services = real Redis + PostgreSQL. embedded = fakeredis + SQLite, no infra.
DEV_MODE=services

DATABASE_URL=postgresql+asyncpg://localhost/budget_controller
REDIS_URL=redis://localhost:6379/0

UPSTREAM_BASE_URL=http://127.0.0.1:9000/v1

# HMAC pepper for API-key hashing. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If unset, a random value is generated per process, which invalidates every
# existing agent key on restart.
API_KEY_PEPPER=

# ---------------------------------------------------------------- demo page
# The Demo page (#/demo) can send a single call to a model's real endpoint
# while everything else keeps using the mock. Set the key for whichever
# provider you want to exercise; the page greys out models whose key is unset.
#
# Note these are read through Settings, not os.environ, so putting them here
# works under both `make dev` and Docker.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Set false to remove the "use real provider" toggle entirely. Worth doing if
# the dashboard is reachable publicly, since it has no authentication and
# anyone who finds it could otherwise spend against your provider quota.
DEMO_ALLOW_LIVE=true

# closed = reject requests when Redis is unreachable (recommended).
ENFORCEMENT_FAIL_MODE=closed

LOG_LEVEL=INFO
LOG_JSON=false
