# Copy to .env and adjust. Defaults target the Homebrew services set up by
# `make infra-up`.

# services = real Redis + PostgreSQL. embedded = fakeredis + SQLite, no infra.
DEV_MODE=services

DATABASE_URL=postgresql+asyncpg://localhost/budget_controller
REDIS_URL=redis://localhost:6379/0

UPSTREAM_BASE_URL=http://127.0.0.1:9000/v1

# HMAC pepper for API-key hashing. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If unset, a random value is generated per process, which invalidates every
# existing agent key on restart.
API_KEY_PEPPER=

# closed = reject requests when Redis is unreachable (recommended).
ENFORCEMENT_FAIL_MODE=closed

LOG_LEVEL=INFO
LOG_JSON=false
